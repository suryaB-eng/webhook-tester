# Disposable local credentials. Compose uses POSTGRES_PASSWORD.
POSTGRES_PASSWORD=superuser_local_only
# Host connection details; the current API does not use a database.
APP_DATABASE_URL=postgresql://webhook_tester_app:app_local_only@127.0.0.1:55432/webhook_tester
TARGET_OWNER_DATABASE_URL=postgresql://demo_target_owner:target_owner_local_only@127.0.0.1:55432/demo_target
# Defaults used by native development commands.
API_HOST=127.0.0.1
API_PORT=4000
API_PROXY_TARGET=http://127.0.0.1:4000
