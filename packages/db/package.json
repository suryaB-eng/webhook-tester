{
	"name": "@webhook-tester/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"test": "tsx --test src/database.integration.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"pg": "8.23.0",
		"@webhook-tester/contracts": "0.1.0"
	},
	"devDependencies": {
		"@types/pg": "8.23.1"
	}
}
